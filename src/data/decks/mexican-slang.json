{
  "id": "mexican-slang",
  "name": "Mexican Slang",
  "emoji": "🇲🇽",
  "description": "Common Mexican expressions you'll hear everywhere.",
  "phase": 3,
  "order": 110,
  "cards": [
    {
      "id": "mexican-slang:no-manches",
      "spanish": "¡No manches!",
      "english": "No way! (mild)",
      "pronunciation": "noh MAHN-chehs",
      "example": "¡No manches! ¿En serio ganaste?",
      "example_en": "No way! You seriously won?",
      "region": "Mexico",
      "register": "slang",
      "notes": "The clean version of \"no mames\"."
    },
    {
      "id": "mexican-slang:no-mames",
      "spanish": "¡No mames!",
      "english": "No way! (strong)",
      "pronunciation": "noh MAH-mehs",
      "example": "¡No mames, güey, qué caro!",
      "example_en": "No way, dude, that's so expensive!",
      "region": "Mexico",
      "register": "vulgar"
    },
    {
      "id": "mexican-slang:qué-onda",
      "spanish": "¿Qué onda?",
      "english": "What's up?",
      "pronunciation": "keh OHN-dah",
      "example": "¿Qué onda, güey? ¿Cómo estás?",
      "example_en": "What's up, dude? How are you?",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:neta",
      "spanish": "Neta",
      "english": "for real",
      "pronunciation": "NEH-tah",
      "example": "¿Neta? No te creo.",
      "example_en": "For real? I don't believe you.",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:qué-pedo",
      "spanish": "¿Qué pedo?",
      "english": "What's up? / What's the deal?",
      "pronunciation": "keh PEH-doh",
      "example": "¿Qué pedo, carnal?",
      "example_en": "What's up, bro?",
      "region": "Mexico",
      "register": "vulgar",
      "notes": "Literally \"what fart?\". Tone decides if it's friendly or aggressive."
    },
    {
      "id": "mexican-slang:no-hay-pedo",
      "spanish": "No hay pedo",
      "english": "no problem",
      "pronunciation": "noh eye PEH-doh",
      "example": "—Perdón por llegar tarde. —No hay pedo.",
      "example_en": "\"Sorry I'm late.\" \"No problem.\"",
      "region": "Mexico",
      "register": "vulgar"
    },
    {
      "id": "mexican-slang:qué-peda",
      "spanish": "¡Qué peda!",
      "english": "What a party! / What a drunk night!",
      "pronunciation": "keh PEH-dah",
      "example": "¡Qué peda la de anoche!",
      "example_en": "What a wild night of drinking last night!",
      "region": "Mexico",
      "register": "slang",
      "notes": "\"La peda\" = a drinking party."
    },
    {
      "id": "mexican-slang:híjole",
      "spanish": "¡Híjole!",
      "english": "Oh man! / Wow!",
      "pronunciation": "EE-hoh-leh",
      "example": "¡Híjole, se me olvidó la cartera!",
      "example_en": "Oh man, I forgot my wallet!",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:órale",
      "spanish": "¡Órale!",
      "english": "Wow! / Okay!",
      "pronunciation": "OH-rah-leh",
      "example": "¡Órale, qué bien bailas!",
      "example_en": "Wow, you dance so well!",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:ahorita",
      "spanish": "Ahorita",
      "english": "right now / in a bit / eventually",
      "pronunciation": "ah-oh-REE-tah",
      "example": "Ahorita voy.",
      "example_en": "I'm coming in a bit (maybe).",
      "region": "Mexico",
      "register": "casual",
      "notes": "In Mexico \"ahorita\" can mean \"later... maybe\". In the Caribbean it means right now."
    },
    {
      "id": "mexican-slang:popote",
      "spanish": "Popote",
      "english": "straw",
      "pronunciation": "poh-POH-teh",
      "example": "¿Me das un popote?",
      "example_en": "Can I have a straw?",
      "region": "Mexico",
      "register": "neutral",
      "notes": "Elsewhere: pajita or sorbete."
    },
    {
      "id": "mexican-slang:güey",
      "spanish": "Güey",
      "english": "dude / bro",
      "pronunciation": "gway",
      "example": "¿Qué onda, [güey]?",
      "example_en": "What's up, dude?",
      "region": "Mexico",
      "register": "slang",
      "notes": "Also spelled \"wey\". Between friends it's friendly; to a stranger it can be rude."
    },
    {
      "id": "mexican-slang:chido",
      "spanish": "Chido",
      "english": "cool",
      "pronunciation": "CHEE-doh",
      "example": "¡Qué [chido] tu carro!",
      "example_en": "Your car is so cool!",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:qué-padre",
      "spanish": "¡Qué padre!",
      "english": "How cool! / Awesome!",
      "pronunciation": "keh PAH-dreh",
      "example": "¡Qué [padre] está la fiesta!",
      "example_en": "The party is awesome!",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:chamba",
      "spanish": "Chamba",
      "english": "work / job",
      "pronunciation": "CHAHM-bah",
      "example": "Tengo mucha [chamba] hoy.",
      "example_en": "I have a lot of work today.",
      "region": "Mexico",
      "register": "slang",
      "notes": "\"Chambear\" = to work."
    },
    {
      "id": "mexican-slang:carnal",
      "spanish": "Carnal",
      "english": "bro / close friend",
      "pronunciation": "kahr-NAHL",
      "example": "Él es mi [carnal].",
      "example_en": "He's my bro.",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:cruda",
      "spanish": "Cruda",
      "english": "hangover",
      "pronunciation": "KROO-dah",
      "example": "Tengo una [cruda] terrible.",
      "example_en": "I have a terrible hangover.",
      "region": "Mexico",
      "register": "slang",
      "notes": "In the Caribbean: \"resaca\" or \"ratón\" (Dominican)."
    },
    {
      "id": "mexican-slang:chela",
      "spanish": "Chela",
      "english": "beer",
      "pronunciation": "CHEH-lah",
      "example": "¿Vamos por unas [chelas]?",
      "example_en": "Shall we go for some beers?",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "mexican-slang:mande",
      "spanish": "¿Mande?",
      "english": "Pardon? / Excuse me? (polite \"what?\")",
      "pronunciation": "MAHN-deh",
      "example": "¿[Mande]? No te escuché.",
      "example_en": "Pardon? I didn't hear you.",
      "region": "Mexico",
      "register": "neutral",
      "notes": "The polite Mexican way to say \"what?\"."
    }
  ]
}
