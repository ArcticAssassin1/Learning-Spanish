{
  "id": "false-friends",
  "name": "False Friends",
  "emoji": "🎭",
  "description": "Words that look like English but mean something else. Some of these can get you in trouble!",
  "phase": 1,
  "order": 18,
  "cards": [
    {
      "id": "false-friends:embarazada",
      "spanish": "embarazada",
      "english": "pregnant (NOT embarrassed)",
      "pronunciation": "ehm-bah-rah-SAH-dah",
      "example": "Mi hermana está [embarazada].",
      "example_en": "My sister is pregnant.",
      "region": "General",
      "register": "neutral",
      "notes": "Embarrassed = \"avergonzado/a\" or \"me da vergüenza\"."
    },
    {
      "id": "false-friends:éxito",
      "spanish": "éxito",
      "english": "success (NOT exit)",
      "pronunciation": "EHK-see-toh",
      "example": "¡La fiesta fue un [éxito]!",
      "example_en": "The party was a success!",
      "region": "General",
      "register": "neutral",
      "notes": "Exit = \"salida\"."
    },
    {
