      "id": "sofia-talk:echar-la-hueva",
      "spanish": "echar la hueva",
      "english": "to laze around / to do nothing",
      "pronunciation": "eh-CHAHR lah WEH-bah",
      "example": "Hoy voy a [echar la hueva] todo el día.",
      "example_en": "Today I'm going to laze around all day.",
      "region": "Mexico",
      "register": "slang"
    },
    {
      "id": "sofia-talk:huevón-huevona",
      "spanish": "huevón / huevona",
      "english": "lazy (bum)",
      "pronunciation": "weh-BOHN / weh-BOH-nah",
      "example": "¡Levántate, no seas [huevón]!",
      "example_en": "Get up, don't be so lazy!",
      "region": "Mexico",
      "register": "vulgar",
      "notes": "Rude-ish. In Chile \"weón\" means \"dude\"."
    },
    {
