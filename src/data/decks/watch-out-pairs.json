{
  "id": "watch-out-pairs",
  "name": "Watch-Out Pairs",
  "emoji": "⚠️",
  "description": "Look-alike words that trip you up: accents, pronouns, and verbs that seem the same.",
  "phase": 1,
  "order": 15,
  "cards": [
    {
      "id": "watch-out-pairs:cono",
      "spanish": "cono",
      "english": "cone",
      "pronunciation": "KOH-noh",
      "example": "Un cono de helado, por favor.",
      "example_en": "An ice-cream cone, please.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"coño\" (expletive). The ñ changes everything!"
    },
    {
      "id": "watch-out-pairs:coño",
      "spanish": "coño",
      "english": "damn! (expletive)",
      "pronunciation": "KOH-nyoh",
      "example": "¡Coño! ¡Qué susto!",
      "example_en": "Damn! What a scare!",
      "region": "Caribbean",
      "register": "vulgar",
      "notes": "vs \"cono\" (cone)."
    },
    {
      "id": "watch-out-pairs:si",
      "spanish": "si",
      "english": "if",
      "pronunciation": "see",
      "example": "Si quieres, vamos.",
      "example_en": "If you want, let's go.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"sí\" (yes)."
    },
    {
      "id": "watch-out-pairs:sí",
      "spanish": "sí",
      "english": "yes",
      "pronunciation": "see",
      "example": "Sí, quiero ir.",
      "example_en": "Yes, I want to go.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"si\" (if)."
    },
    {
      "id": "watch-out-pairs:se",
      "spanish": "se",
      "english": "himself / herself / themselves (reflexive)",
      "pronunciation": "seh",
      "example": "Él se levanta temprano.",
      "example_en": "He gets up early.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"sé\" (I know)."
    },
    {
      "id": "watch-out-pairs:sé",
      "spanish": "sé",
      "english": "I know",
      "pronunciation": "seh",
      "example": "No sé qué comer.",
      "example_en": "I don't know what to eat.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"se\" (himself / herself). \"Yo sé\", never \"yo sabo\"."
    },
    {
      "id": "watch-out-pairs:esta",
      "spanish": "esta",
      "english": "this (feminine)",
      "pronunciation": "EHS-tah",
      "example": "Esta noche salimos.",
      "example_en": "Tonight we're going out.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"está\" (is)."
    },
    {
      "id": "watch-out-pairs:está",
      "spanish": "está",
      "english": "is (location / temporary)",
      "pronunciation": "ehs-TAH",
      "example": "Ella está en el gym.",
      "example_en": "She's at the gym.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"esta\" (this)."
    },
    {
      "id": "watch-out-pairs:tu",
      "spanish": "tu",
      "english": "your",
      "pronunciation": "too",
      "example": "¿Dónde está tu carro?",
      "example_en": "Where's your car?",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"tú\" (you). To say \"see you\", use \"verte\", not \"ver tu\"."
    },
    {
      "id": "watch-out-pairs:tú",
      "spanish": "tú",
      "english": "you",
      "pronunciation": "too",
      "example": "¿Tú vas a la fiesta?",
      "example_en": "Are you going to the party?",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"tu\" (your)."
    },
    {
      "id": "watch-out-pairs:mi",
      "spanish": "mi",
      "english": "my",
      "pronunciation": "mee",
      "example": "Mi pana viene esta noche.",
      "example_en": "My buddy is coming tonight.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"mí\" (me, after a preposition) and \"me\" (me / to me)."
    },
    {
      "id": "watch-out-pairs:mí",
      "spanish": "mí",
      "english": "me (after a preposition)",
      "pronunciation": "mee",
      "example": "¿Es para mí?",
      "example_en": "Is it for me?",
      "region": "General",
      "register": "neutral",
      "notes": "Used after para, a, de, sin... \"para mí\", \"a mí\"."
    },
    {
      "id": "watch-out-pairs:me",
      "spanish": "me",
      "english": "me / to me (object)",
      "pronunciation": "meh",
      "example": "¿Me das un beso?",
      "example_en": "Will you give me a kiss?",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"mi\" (my). Say \"dame\" or \"me das\", never \"dar mi\"."
    },
    {
      "id": "watch-out-pairs:conmigo",
      "spanish": "conmigo",
      "english": "with me",
      "pronunciation": "kohn-MEE-goh",
      "example": "¿Vienes conmigo?",
      "example_en": "Are you coming with me?",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"contigo\" (with you)."
    },
    {
      "id": "watch-out-pairs:contigo",
      "spanish": "contigo",
      "english": "with you",
      "pronunciation": "kohn-TEE-goh",
      "example": "Quiero ir contigo.",
      "example_en": "I want to go with you.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"conmigo\" (with me)."
    },
    {
      "id": "watch-out-pairs:muy",
      "spanish": "muy",
      "english": "very (with adjectives)",
      "pronunciation": "mwee",
      "example": "Estoy muy cansado.",
      "example_en": "I'm very tired.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"mucho\" (a lot). muy + adjective, mucho + noun/verb."
    },
    {
      "id": "watch-out-pairs:mucho",
      "spanish": "mucho",
      "english": "a lot (with nouns / verbs)",
      "pronunciation": "MOO-choh",
      "example": "Te quiero mucho.",
      "example_en": "I love you a lot.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"muy\" (very)."
    },
    {
      "id": "watch-out-pairs:ir",
      "spanish": "ir",
      "english": "to go (to a destination)",
      "pronunciation": "eer",
      "example": "Voy a ir a la playa.",
      "example_en": "I'm going to go to the beach.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"salir\" (to leave / go out)."
    },
    {
      "id": "watch-out-pairs:salir",
      "spanish": "salir",
      "english": "to leave / to go out",
      "pronunciation": "sah-LEER",
      "example": "Salgo del trabajo a las cinco.",
      "example_en": "I leave work at five.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"ir\" (to go somewhere)."
    },
    {
      "id": "watch-out-pairs:buscar",
      "spanish": "buscar",
      "english": "to look for",
      "pronunciation": "boos-KAHR",
      "example": "Estoy buscando mis llaves.",
      "example_en": "I'm looking for my keys.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"mirar\" (to look at). No \"for\" needed: \"busco mis llaves\"."
    },
    {
      "id": "watch-out-pairs:mirar",
      "spanish": "mirar",
      "english": "to look at / to watch",
      "pronunciation": "mee-RAHR",
      "example": "Mira esa foto.",
      "example_en": "Look at that photo.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"buscar\" (to look for)."
    },
    {
      "id": "watch-out-pairs:escuchar",
      "spanish": "escuchar",
      "english": "to listen",
      "pronunciation": "ehs-koo-CHAHR",
      "example": "Escucho bachata en el carro.",
      "example_en": "I listen to bachata in the car.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"oír\" (to hear)."
    },
    {
      "id": "watch-out-pairs:oír",
      "spanish": "oír",
      "english": "to hear",
      "pronunciation": "oh-EER",
      "example": "¿Oíste eso?",
      "example_en": "Did you hear that?",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"escuchar\" (to listen)."
    },
    {
      "id": "watch-out-pairs:tocar",
      "spanish": "tocar",
      "english": "to play (an instrument) / to touch",
      "pronunciation": "toh-KAHR",
      "example": "Toco la guitarra.",
      "example_en": "I play the guitar.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"jugar\" (to play a game / sport)."
    },
    {
      "id": "watch-out-pairs:jugar",
      "spanish": "jugar",
      "english": "to play (a game / sport)",
      "pronunciation": "hoo-GAHR",
      "example": "Jugamos dominó los domingos.",
      "example_en": "We play dominoes on Sundays.",
      "region": "General",
      "register": "neutral",
      "notes": "vs \"tocar\" (to play an instrument)."
    },
    {
      "id": "watch-out-pairs:para-allá",
      "spanish": "para allá",
      "english": "over there (more common)",
      "pronunciation": "PAH-rah ah-YAH",
      "example": "Vamos para allá.",
      "example_en": "Let's go over there.",
      "region": "General",
      "register": "casual",
      "notes": "vs \"para ahí\" (there, closer)."
    },
    {
      "id": "watch-out-pairs:para-ahí",
      "spanish": "para ahí",
      "english": "there / that way (closer)",
      "pronunciation": "PAH-rah ah-EE",
      "example": "Muévete para ahí.",
      "example_en": "Move over there.",
      "region": "General",
      "register": "casual",
      "notes": "vs \"para allá\" (over there, farther away)."
    },
    {
      "id": "watch-out-pairs:coger",
      "spanish": "coger",
      "english": "to take / to grab (Spain)",
      "pronunciation": "koh-HEHR",
      "example": "Voy a coger el autobús.",
      "example_en": "I'm going to catch the bus. (Spain)",
      "region": "Spain",
      "register": "vulgar",
      "notes": "⚠️ Normal in Spain and the Caribbean, but in Mexico and much of Latin America it means to have sex. Use agarrar / tomar there."
    },
    {
      "id": "watch-out-pairs:agarrar-tomar",
      "spanish": "agarrar / tomar",
      "english": "to take / to grab (Latin America)",
      "pronunciation": "ah-gah-RRAHR / toh-MAHR",
      "example": "Voy a tomar el autobús.",
      "example_en": "I'm going to take the bus.",
      "region": "General",
      "register": "neutral",
      "notes": "The safe choice in Latin America (vs \"coger\")."
    }
  ]
}
