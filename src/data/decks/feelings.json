      "region": "General",
      "register": "casual",
      "notes": "Woman: \"contenta\"."
    },
    {
      "id": "feelings:estoy-nervioso",
      "spanish": "Estoy nervioso",
      "english": "I'm nervous",
      "pronunciation": "ehs-TOY nehr-BYOH-soh",
