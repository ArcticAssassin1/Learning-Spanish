      "region": "General",
      "register": "casual"
    },
    {
      "id": "feelings:depende",
      "spanish": "Depende",
      "english": "It depends",
      "pronunciation": "deh-PEHN-deh",
      "example": "—¿Vas a salir? —[Depende].",
      "example_en": "\"Are you going out?\" \"It depends.\"",
      "region": "General",
      "register": "casual"
    },
    {
