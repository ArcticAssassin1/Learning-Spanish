      "example_en": "I'm nervous about the date.",
      "region": "General",
      "register": "casual"
    },
    {
      "id": "feelings:estoy-emocionado",
      "spanish": "Estoy emocionado",
      "english": "I'm excited",
      "pronunciation": "ehs-TOY eh-moh-syoh-NAH-doh",
