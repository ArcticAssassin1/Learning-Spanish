      "example_en": "I'm fed up with the traffic.",
      "region": "General",
      "register": "casual",
      "notes": "Woman: \"estoy harta\"."
    },
    {
      "id": "feelings:estoy-contento",
      "spanish": "Estoy contento",
      "english": "I'm happy",
      "pronunciation": "ehs-TOY kohn-TEHN-toh",
