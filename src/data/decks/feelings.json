      "example_en": "Yeah, you're right.",
      "region": "General",
      "register": "casual"
    },
    {
      "id": "feelings:no-estoy-de-acuerdo",
      "spanish": "No estoy de acuerdo",
      "english": "I don't agree",
      "pronunciation": "noh ehs-TOY deh ah-KWEHR-doh",
