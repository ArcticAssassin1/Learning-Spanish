    {
      "id": "caribbean-sounds:etá",
      "spanish": "etá",
      "english": "está / is",
      "pronunciation": "eh-TAH",
      "example": "¿Dónde tú [etá]?",
      "example_en": "Where are you?",
      "region": "Caribbean",
      "register": "casual",
      "notes": "Dropped s: before a consonant the s turns into a soft \"h\" or disappears.",
      "say": "está"
    },
    {
